SELECT *
FROM Employees
WHERE salary > (
    SELECT AVG(salary) 
    FROM Employees
);

SELECT *
FROM Employees
WHERE dept_id = (
    SELECT dept_id 
    FROM Departments 
    WHERE dept_name = 'Engineering'
);

SELECT emp_name
FROM Employees
WHERE emp_id IN (
    SELECT DISTINCT emp_id 
    FROM Employee_Projects
);

SELECT emp_name
FROM Employees
WHERE emp_id NOT IN (
    SELECT emp_id 
    FROM Employee_Projects 
    WHERE emp_id IS NOT NULL
);

SELECT *
FROM Projects
WHERE budget = (
    SELECT MAX(budget) 
    FROM Projects
);

SELECT d.dept_name, SUM(p.budget) AS total_project_budget
FROM Departments d
JOIN Projects p ON d.dept_id = p.dept_id
GROUP BY d.dept_id, d.dept_name
HAVING SUM(p.budget) > (
    SELECT AVG(budget) 
    FROM Projects
);

SELECT *
FROM Employees
WHERE salary > (
    SELECT MAX(salary)
    FROM Employees
    WHERE dept_id = (
        SELECT dept_id 
        FROM Departments 
        WHERE dept_name = 'Marketing'
    )
);

SELECT e1.emp_name, e1.dept_id, e1.salary
FROM Employees e1
WHERE e1.salary > (
    SELECT AVG(e2.salary)
    FROM Employees e2
    WHERE e2.dept_id = e1.dept_id
);

SELECT dept_name
FROM Departments d
WHERE EXISTS (
    SELECT 1
    FROM Employees e
    WHERE e.dept_id = d.dept_id
);

SELECT dept_name
FROM Departments d
WHERE NOT EXISTS (
    SELECT 1
    FROM Projects p
    WHERE p.dept_id = d.dept_id
);

SELECT 
    emp_name,
    salary,
    (SELECT SUM(salary) FROM Employees) AS total_company_payroll
FROM Employees;

SELECT *
FROM Employees
WHERE hire_date = (
    SELECT MIN(hire_date) 
    FROM Employees
);

SELECT MAX(salary) AS second_highest_salary
FROM Employees
WHERE salary < (
    SELECT MAX(salary) 
    FROM Employees
);

SELECT *
FROM Projects
WHERE budget > (
    SELECT SUM(budget)
    FROM Projects
    WHERE dept_id = (
        SELECT dept_id 
        FROM Departments 
        WHERE dept_name = 'Sales'
    )
);

SELECT 
    e.emp_id, 
    e.emp_name AS employee_name, 
    e.dept_id AS emp_dept_id,
    m.emp_name AS manager_name, 
    m.dept_id AS manager_dept_id
FROM Employees e
JOIN Employees m ON e.manager_id = m.emp_id
WHERE e.dept_id <> m.dept_id;

SELECT dept_name
FROM Departments
WHERE dept_id = (
    SELECT dept_id
    FROM Employees
    GROUP BY dept_id
    ORDER BY COUNT(*) DESC
    LIMIT 1
);

SELECT DISTINCT e.emp_name
FROM Employees e
JOIN Employee_Projects ep ON e.emp_id = ep.emp_id
WHERE ep.project_id IN (
    SELECT project_id
    FROM Employee_Projects
    GROUP BY project_id
    HAVING SUM(hours_worked) = (
        SELECT MAX(total_hours)
        FROM (
            SELECT SUM(hours_worked) AS total_hours
            FROM Employee_Projects
            GROUP BY project_id
        ) sub
    )
);

SELECT *
FROM Departments
WHERE dept_id IN (
    SELECT dept_id
    FROM Departments
    WHERE location LIKE 'New%' OR location LIKE 'San%'
);

SELECT *
FROM Employees
WHERE salary > ANY (
    SELECT salary
    FROM Employees
    WHERE hire_date >= '2024-01-01' AND hire_date <= '2024-12-31'
);

SELECT emp_name
FROM Employees
WHERE emp_id IN (
    SELECT manager_id
    FROM Employees
    WHERE manager_id IS NOT NULL
    GROUP BY manager_id
    HAVING COUNT(*) >= 2
);

SELECT project_name, budget
FROM Projects
WHERE budget < (
    SELECT AVG(budget) 
    FROM Projects
);

SELECT e.emp_name, p.project_name
FROM Employees e
JOIN Employee_Projects ep ON e.emp_id = ep.emp_id
JOIN Projects p ON ep.project_id = p.project_id
WHERE ep.project_id IN (
    SELECT project_id
    FROM Employee_Projects
    GROUP BY project_id
    HAVING COUNT(emp_id) = 1
);

SELECT 
    e.emp_name,
    e.salary,
    e.salary - (
        SELECT AVG(e2.salary)
        FROM Employees e2
        WHERE e2.dept_id = e.dept_id
    ) AS salary_diff_from_dept_avg
FROM Employees e;

SELECT d.dept_name, SUM(e.salary) AS total_payroll
FROM Departments d
JOIN Employees e ON d.dept_id = e.dept_id
GROUP BY d.dept_id, d.dept_name
HAVING SUM(e.salary) = (
    SELECT MIN(dept_payroll)
    FROM (
        SELECT SUM(salary) AS dept_payroll
        FROM Employees
        GROUP BY dept_id
    ) sub
);

SELECT DISTINCT p.project_id, p.project_name
FROM Projects p
JOIN Employee_Projects ep ON p.project_id = ep.project_id
WHERE ep.emp_id IN (
    SELECT emp_id
    FROM Employees
    WHERE dept_id = (
        SELECT dept_id
        FROM Departments
        WHERE dept_name = 'Engineering'
    )
);