DROP TABLE IF EXISTS Inventory_Audit;
DROP TABLE IF EXISTS Products;

CREATE TABLE Products (
    product_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100),
    price DECIMAL(10, 2),
    stock_quantity INT,
    status VARCHAR(20) DEFAULT 'Available'
);

CREATE TABLE Inventory_Audit (
    audit_id INT PRIMARY KEY AUTO_INCREMENT,
    product_id INT,
    action_type VARCHAR(50),
    old_value VARCHAR(100),
    new_value VARCHAR(100),
    changed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

DELIMITER //

CREATE TRIGGER trg_prevent_negative_stock
BEFORE UPDATE ON Products
FOR EACH ROW
BEGIN
    IF NEW.stock_quantity < 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Stock cannot be negative';
    END IF;
END //

CREATE TRIGGER trg_audit_price_changes
AFTER UPDATE ON Products
FOR EACH ROW
BEGIN
    IF OLD.price <> NEW.price THEN
        INSERT INTO Inventory_Audit (product_id, action_type, old_value, new_value)
        VALUES (NEW.product_id, 'PRICE_UPDATE', OLD.price, NEW.price);
    END IF;
END //

CREATE TRIGGER trg_auto_out_of_stock
BEFORE UPDATE ON Products
FOR EACH ROW
BEGIN
    IF NEW.stock_quantity = 0 THEN
        SET NEW.status = 'Out of Stock';
    END IF;
END //

CREATE TRIGGER trg_uppercase_product_name
BEFORE INSERT ON Products
FOR EACH ROW
BEGIN
    SET NEW.name = UPPER(NEW.name);
END //

CREATE TRIGGER trg_log_new_product
AFTER INSERT ON Products
FOR EACH ROW
BEGIN
    INSERT INTO Inventory_Audit (product_id, action_type, old_value, new_value)
    VALUES (NEW.product_id, 'NEW_PRODUCT', NULL, NEW.name);
END //

CREATE TRIGGER trg_prevent_active_product_deletion
BEFORE DELETE ON Products
FOR EACH ROW
BEGIN
    IF OLD.stock_quantity > 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Cannot delete product with stock remaining';
    END IF;
END //

CREATE TRIGGER trg_track_deleted_products
AFTER DELETE ON Products
FOR EACH ROW
BEGIN
    INSERT INTO Inventory_Audit (product_id, action_type, old_value, new_value)
    VALUES (OLD.product_id, 'PRODUCT_DELETED', OLD.name, NULL);
END //

CREATE TRIGGER trg_min_price_insert
BEFORE INSERT ON Products
FOR EACH ROW
BEGIN
    IF NEW.price < 1.00 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Price must be at least 1.00';
    END IF;
END //

CREATE TRIGGER trg_record_stock_replenishment
AFTER UPDATE ON Products
FOR EACH ROW
BEGIN
    IF NEW.stock_quantity > OLD.stock_quantity THEN
        INSERT INTO Inventory_Audit (product_id, action_type, old_value, new_value)
        VALUES (NEW.product_id, 'STOCK_ADDED', OLD.stock_quantity, NEW.stock_quantity);
    END IF;
END //

CREATE TRIGGER trg_prevent_weekend_price_drops
BEFORE UPDATE ON Products
FOR EACH ROW
BEGIN
    IF DAYOFWEEK(CURDATE()) IN (1, 7) AND NEW.price < OLD.price THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Price drops not allowed on weekends';
    END IF;
END //

DELIMITER ;