
WITH avg_salary AS (
    SELECT AVG(salary) AS company_avg
    FROM employees
)
SELECT e.emp_id, e.emp_name, e.department, e.salary
FROM employees e, avg_salary a
WHERE e.salary > a.company_avg;



WITH dept_salary AS (
    SELECT department, AVG(salary) AS average_salary
    FROM employees
    GROUP BY department
)
SELECT department, average_salary
FROM dept_salary;



WITH average_mark AS (
    SELECT AVG(mark) AS overall_avg
    FROM students
)
SELECT s.student_name, s.course, s.mark
FROM students s, average_mark a
WHERE s.mark > a.overall_avg;



WITH product_data AS (
    SELECT product_name, category, price
    FROM products
)
SELECT product_name, category, price
FROM product_data
WHERE price > 20000;



WITH employee_bonus AS (
    SELECT 
        emp_id, 
        emp_name, 
        salary, 
        salary * 0.10 AS bonus
    FROM employees
)
SELECT 
    emp_name, 
    salary, 
    bonus, 
    (salary + bonus) AS total_salary
FROM employee_bonus;