CREATE DATABASE companyDB;

USE companyDB;

CREATE TABLE Student (
    StudentID INT PRIMARY KEY,
    StudentName VARCHAR(50),
    Email VARCHAR(100) UNIQUE,
    Age INT,
    Address VARCHAR(100)
);

